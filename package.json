{
  "name": "cambium",
  "private": true,
  "version": "0.1.0",
  "description": "Cambium — tree physiology PWA: sugar maple sap run and fruit-tree fruiting modes",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/cambium.css --minify",
    "build:js": "node scripts/build-js.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/cambium.css --watch",
    "watch:js": "node scripts/watch-js.js",
    "watch": "concurrently -k -n css,js -c magenta,cyan \"npm:watch:css\" \"npm:watch:js\"",
    "start": "npm run watch"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
